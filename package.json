{
  "name": "opencounty-site",
  "private": true,
  "version": "1.0.0",
  "description": "Open County static site (home and growth pages)",
  "scripts": {
    "build:css": "tailwindcss -c tailwind.config.js -i src/input.css -o css/site.css --minify",
